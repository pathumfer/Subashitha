{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Debug App",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api:build",
      "program": "${workspaceFolder}/api/Subhashitha.App/bin/Debug/net10.0/Subhashitha.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}/api/Subhashitha.App",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "{0}",
        "action": "openExternally"
      }
    },
    {
      "name": ".NET + Web (compound)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "web:dev",
      "program": "${workspaceFolder}/api/Subhashitha.App/bin/Debug/net10.0/Subhashitha.App.dll",
      "args": [],
      "cwd": "${workspaceFolder}/api/Subhashitha.App",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "{0}",
        "action": "openExternally"
      }
    }
  ]
}
